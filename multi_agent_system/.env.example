# ============================================================================
# 多智能体应用开发系统 - 环境变量配置
# ============================================================================
# 使用说明：
#   1. 复制此文件为 .env: cp .env.example .env
#   2. 编辑 .env 文件，填入实际值
#   3. 不要将 .env 文件提交到版本控制

# ============================================================================
# 应用基础配置
# ============================================================================

# 应用名称
APP_NAME=multi-agent-system

# 应用版本
APP_VERSION=1.0.0

# 运行环境: development | staging | production
ENVIRONMENT=development

# 调试模式: true | false
DEBUG=true

# 服务端口
APP_HOST=0.0.0.0
APP_PORT=8000

# 工作进程数 (仅生产环境生效)
WORKERS=4

# ============================================================================
# OpenAI 配置
# ============================================================================

# OpenAI API 密钥 (必填)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# 默认模型: gpt-4 | gpt-4-turbo | gpt-3.5-turbo
# OPENAI_MODEL=gpt-4

# 温度参数 (0.0-2.0): 越低越确定，越高越随机
# OPENAI_TEMPERATURE=0.3

# 最大 Token 数
# OPENAI_MAX_TOKENS=4000

# 请求超时时间 (秒)
# OPENAI_TIMEOUT=60

# 最大重试次数
# OPENAI_MAX_RETRIES=3

# 组织 ID (可选)
# OPENAI_ORG_ID=

# ============================================================================
# 本地LLM配置 (MiMo)
# ============================================================================

# 本地LLM API 密钥
LOCAL_LLM_API_KEY=sk-your-local-llm-api-key-here

# 本地LLM API 基础URL
LOCAL_LLM_BASE_URL=http://localhost:8000/v1

# 本地LLM 模型名称
LOCAL_LLM_MODEL=mimo

# 温度参数 (0.0-2.0): 越低越确定，越高越随机
LOCAL_LLM_TEMPERATURE=0.3

# 最大 Token 数
LOCAL_LLM_MAX_TOKENS=4000

# 请求超时时间 (秒)
LOCAL_LLM_TIMEOUT=120

# 最大重试次数
LOCAL_LLM_MAX_RETRIES=3

# ============================================================================
# 数据库配置 (PostgreSQL)
# ============================================================================

# 数据库主机
POSTGRES_HOST=localhost

# 数据库端口
POSTGRES_PORT=5432

# 数据库用户
POSTGRES_USER=postgres

# 数据库密码
POSTGRES_PASSWORD=postgres

# 数据库名称
POSTGRES_DB=multi_agent_dev

# 数据库连接 URL (优先级高于单独配置)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multi_agent_dev

# 连接池配置
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================================================
# Redis 配置
# ============================================================================

# Redis 主机
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码 (留空表示无密码)
REDIS_PASSWORD=redis

# Redis 数据库索引
REDIS_DB=0

# Redis 连接 URL (优先级高于单独配置)
REDIS_URL=redis://localhost:6379/0

# 连接池配置
REDIS_MAX_CONNECTIONS=50

# ============================================================================
# Celery 配置 (异步任务队列)
# ============================================================================

# Broker URL
CELERY_BROKER_URL=redis://localhost:6379/1

# Result Backend
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 任务序列化格式
CELERY_TASK_SERIALIZER=json

# 结果序列化格式
CELERY_RESULT_SERIALIZER=json

# 任务过期时间 (秒)
CELERY_TASK_EXPIRES=3600

# 并发工作进程数
CELERY_CONCURRENCY=4

# ============================================================================
# 日志配置
# ============================================================================

# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/system.log

# 日志格式
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# 日志轮转大小 (MB)
LOG_ROTATION_SIZE=10

# 日志保留天数
LOG_RETENTION_DAYS=30

# JSON 格式日志: true | false
LOG_JSON_FORMAT=false

# ============================================================================
# 安全配置
# ============================================================================

# JWT 密钥 (用于生成和验证 Token)
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# JWT 算法
JWT_ALGORITHM=HS256

# Access Token 过期时间 (分钟)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token 过期时间 (天)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 允许的源 (逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# CORS 允许的方法
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# CORS 允许的头
CORS_HEADERS=*

# 代码沙箱执行: true | false
SANDBOX_ENABLED=true

# 最大执行时间 (秒)
MAX_EXECUTION_TIME=300

# 允许的文件扩展名 (逗号分隔)
ALLOWED_FILE_EXTENSIONS=.py,.js,.ts,.json,.yaml,.yml,.md,.txt

# 最大文件大小 (MB)
MAX_FILE_SIZE=10

# ============================================================================
# 状态管理配置
# ============================================================================

# 启用状态持久化: true | false
STATE_PERSISTENCE=true

# 状态存储路径
STATE_STORAGE=./data/states

# 状态过期时间 (天)
STATE_EXPIRY_DAYS=30

# ============================================================================
# 成本控制配置
# ============================================================================

# 每次请求最大 Token 数
MAX_TOKENS_PER_REQUEST=8000

# 每分钟最大请求数
MAX_REQUESTS_PER_MINUTE=60

# 每日最大请求数
MAX_REQUESTS_PER_DAY=1000

# 月度预算 (美元)
MONTHLY_BUDGET=1000.0

# 预算警告阈值 (百分比)
BUDGET_WARNING_THRESHOLD=80

# 预算超限行为: warn | block
BUDGET_EXCEED_ACTION=warn

# ============================================================================
# 智能体配置
# ============================================================================

# 需求分析师配置
AGENT_REQUIREMENTS_MODEL=mimo
AGENT_REQUIREMENTS_TEMPERATURE=0.3
AGENT_REQUIREMENTS_MAX_TOKENS=4000

# 技术架构师配置
AGENT_TECHNICAL_MODEL=mimo
AGENT_TECHNICAL_TEMPERATURE=0.2
AGENT_TECHNICAL_MAX_TOKENS=6000

# MVP 开发者配置
AGENT_MVP_MODEL=mimo
AGENT_MVP_TEMPERATURE=0.4
AGENT_MVP_MAX_TOKENS=8000

# 代码审查员配置
AGENT_CODE_REVIEW_MODEL=mimo
AGENT_CODE_REVIEW_TEMPERATURE=0.1
AGENT_CODE_REVIEW_MAX_TOKENS=4000

# 测试工程师配置
AGENT_TESTING_MODEL=mimo
AGENT_TESTING_TEMPERATURE=0.1
AGENT_TESTING_MAX_TOKENS=4000

# 部署工程师配置
AGENT_DEPLOYMENT_MODEL=mimo
AGENT_DEPLOYMENT_TEMPERATURE=0.2
AGENT_DEPLOYMENT_MAX_TOKENS=4000

# 智能体最大迭代次数
AGENT_MAX_ITERATIONS=10

# 智能体详细日志: true | false
AGENT_VERBOSE=true

# ============================================================================
# 监控配置 (Prometheus)
# ============================================================================

# Prometheus 端口
PROMETHEUS_PORT=9090

# 启用指标收集: true | false
METRICS_ENABLED=true

# 指标路径
METRICS_PATH=/metrics

# ============================================================================
# Grafana 配置
# ============================================================================

# Grafana 端口
GRAFANA_PORT=3000

# Grafana 管理员用户
GRAFANA_USER=admin

# Grafana 管理员密码
GRAFANA_PASSWORD=admin

# ============================================================================
# Flower 配置 (Celery 监控)
# ============================================================================

# Flower 端口
FLOWER_PORT=5555

# Flower 管理员用户
FLOWER_USER=admin

# Flower 管理员密码
FLOWER_PASSWORD=admin

# ============================================================================
# Nginx 配置
# ============================================================================

# HTTP 端口
HTTP_PORT=80

# HTTPS 端口
HTTPS_PORT=443

# 域名 (生产环境)
DOMAIN_NAME=localhost

# SSL 证书路径 (生产环境)
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem

# ============================================================================
# Adminer 配置 (数据库管理，仅开发环境)
# ============================================================================

# Adminer 端口
ADMINER_PORT=8080

# ============================================================================
# Mailhog 配置 (邮件测试，仅开发环境)
# ============================================================================

# SMTP 端口
MAILHOG_PORT=1025

# Web UI 端口
MAILHOG_UI_PORT=8025

# ============================================================================
# MinIO 配置 (对象存储，可选)
# ============================================================================

# MinIO 访问密钥
MINIO_ROOT_USER=minioadmin

# MinIO 密钥
MINIO_ROOT_PASSWORD=minioadmin

# MinIO API 端口
MINIO_API_PORT=9000

# MinIO 控制台端口
MINIO_CONSOLE_PORT=9001

# ============================================================================
# LangSmith 配置 (可选，LangChain 调试)
# ============================================================================

# 启用 LangSmith 追踪: true | false
LANGCHAIN_TRACING_V2=false

# LangSmith API 密钥
LANGCHAIN_API_KEY=your-langsmith-api-key

# LangSmith 项目名称
LANGCHAIN_PROJECT=multi-agent-system

# ============================================================================
# 邮件配置 (可选)
# ============================================================================

# SMTP 服务器
SMTP_HOST=smtp.gmail.com

# SMTP 端口
SMTP_PORT=587

# SMTP 用户名
SMTP_USER=your-email@gmail.com

# SMTP 密码
SMTP_PASSWORD=your-email-password

# 发件人名称
EMAIL_FROM_NAME=Multi-Agent System

# 发件人邮箱
EMAIL_FROM_ADDRESS=noreply@example.com

# ============================================================================
# 云服务配置 (可选)
# ============================================================================

# AWS 配置
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Azure 配置
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus

# GCP 配置
GCP_PROJECT_ID=
GCP_REGION=us-central1

# ============================================================================
# 第三方服务配置 (可选)
# ============================================================================

# Slack Webhook (用于通知)
SLACK_WEBHOOK_URL=

# Discord Webhook (用于通知)
DISCORD_WEBHOOK_URL=

# Sentry DSN (用于错误追踪)
SENTRY_DSN=

# ============================================================================
# 开发工具配置 (仅开发环境)
# ============================================================================

# 启用热重载: true | false
HOT_RELOAD=true

# 启用调试器: true | false
DEBUGGER_ENABLED=true

# 调试器端口
DEBUGGER_PORT=5678

# 启用 API 文档: true | false
DOCS_ENABLED=true

# API 文档路径
DOCS_URL=/docs

# ReDoc 路径
REDOC_URL=/redoc
